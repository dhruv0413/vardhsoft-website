# =============================================================================
# VardhSoft Website — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values before running the app.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Database (Supabase PostgreSQL) ------------------------------------------

# Transaction-mode pooler URL (used at runtime, supports pgbouncer)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (used for migrations and Payload schema sync)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Payload CMS -------------------------------------------------------------

# Random 64-character hex string used for JWT signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Email (Resend) ----------------------------------------------------------

# API key from https://resend.com — used for transactional email from the contact form
RESEND_API_KEY=

# --- Site URL ----------------------------------------------------------------

# Public-facing site URL (no trailing slash)
# Development: http://localhost:3000
# Production:  https://vardhsoft.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
